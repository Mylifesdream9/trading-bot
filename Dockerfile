# ═════════════════════════════════════════════════════════
#  البوت ثنائي الاستراتيجية V11 — ملفان فقط: bot.py + web_panel.py
#  المكتبات مثبتة هنا مباشرة — لا حاجة لملف requirements.txt
# ═════════════════════════════════════════════════════════
FROM python:3.11-slim

WORKDIR /bot

# المكتبات الخمس المطلوبة فقط — كلها بحزم جاهزة (بدون مترجم)
RUN pip install --no-cache-dir \
    "aiohttp>=3.9" \
    "websockets>=11" \
    "aiosqlite>=0.19" \
    "pandas>=2.0" \
    "numpy>=1.24" \
    "requests>=2.31"

# ⬅️ ملفان فقط — مستحيل أن يفلت ملف من القائمة
COPY bot.py web_panel.py ./

RUN mkdir -p /bot/logs
EXPOSE 8080

# المحرك الجديد — فيه الاستراتيجيتان: 🚀 راكب الترند + 📐 موجات 7/25/99
# (لا يوجد أي أثر لاستراتيجية القناص)
CMD ["python", "-u", "bot.py"]
